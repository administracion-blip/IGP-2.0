# ──────────────────────────────────────────
# AWS / DynamoDB
# ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# ──────────────────────────────────────────
# Tablas DynamoDB
# ──────────────────────────────────────────
DDB_USUARIOS=igp_usuarios
DDB_LOCALES=igp_Locales
DDB_EMPRESAS=igp_Empresas
DDB_ALMACENES=igp_Almacenes
DDB_AGORA_PRODUCTOS=Igp_AgoraProducts
DDB_ROLES_PERMISOS_TABLE=Igp_RolesPermisos
DDB_SALES_CLOSEOUTS_TABLE=Igp_SalesCloseouts
DDB_SALE_CENTERS_TABLE=Igp_SaleCenters
DDB_GESTION_FESTIVOS_TABLE=Igp_Gestionfestivosyestimaciones
DDB_MANTENIMIENTO_TABLE=Igp_Mantenimiento
DDB_MISTERY_GUEST=Igp_MysteryGuest
DDB_EMPLEADOS=Igp_Empleados

# ──────────────────────────────────────────
# Seguridad: JWT
# ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ──────────────────────────────────────────
# Seguridad: secreto de sincronización interna
# ──────────────────────────────────────────
# Obligatorio. Lo envían los jobs y scripts/sync-closeouts-interval.js en la
# cabecera X-Internal-Secret. Debe ser largo y aleatorio (p. ej. 64 caracteres
# hexadecimales: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
INTERNAL_SYNC_SECRET=

# ──────────────────────────────────────────
# Seguridad: CORS
# ──────────────────────────────────────────
# Orígenes adicionales (separados por coma). Los de localhost se incluyen por defecto.
# Ejemplo producción: https://app.midominio.com,https://admin.midominio.com
CORS_ALLOWED_ORIGINS=

# ──────────────────────────────────────────
# Seguridad: Rate Limiting
# ──────────────────────────────────────────
# Login: 15 intentos por ventana de 15 min (por IP)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=15
# General API: 200 peticiones por minuto (por IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ──────────────────────────────────────────
# APIs externas
# ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
AGORA_API_BASE_URL=
AGORA_API_TOKEN=
FACTORIAL_API_KEY=
# Versión del API de Factorial. Default seguro: 2025-10-01 (necesario para shift_management,
# attendance/shifts y contracts/contract_versions usados en el cuadrante).
# FACTORIAL_API_VERSION=2025-10-01
OPENAI_API_KEY=

# ──────────────────────────────────────────
# Email (SMTP) — envío de facturas, recordatorios e informe diario
# ──────────────────────────────────────────
# Gmail: usa una "Contraseña de aplicación" (no la del correo). Requiere verificación en 2 pasos.
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente mostrado (opcional; por defecto = SMTP_USER)
SMTP_FROM=

# ──────────────────────────────────────────
# Servidor
# ──────────────────────────────────────────
PORT=3002
