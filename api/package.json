{
  "name": "erp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "dev": "node --env-file-if-exists=.env.local --watch --watch-path=./server.js --watch-path=./routes --watch-path=./lib --watch-path=./middleware server.js",
    "sync-closeouts": "node scripts/full-sync-closeouts.js",
    "sync-closeouts:interval": "node scripts/sync-closeouts-interval.js",
    "seed-gestion-festivos": "node scripts/seed-gestion-festivos.js",
    "cleanup-pedidos-lineas-huerfanas": "node scripts/cleanup-pedidos-lineas-huerfanas.js",
    "reset-password": "node scripts/reset-password.js",
    "facturar-mantenimiento": "node scripts/facturar-mantenimiento.js",
    "facturar-ventas-internas": "node scripts/facturar-ventas-internas.js",
    "facturar-rappel": "node scripts/facturar-rappel.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:mayorista-calculos": "node lib/mayorista/calculos.selftest.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-transcribe": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@napi-rs/canvas": "^0.1.97",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.2",
    "googleapis": "^176.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^5.1.1"
  }
